{
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ecommerce-admin-api-8nw6.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|api/|mockServiceWorker.js|ecommerce-cart.svg|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
